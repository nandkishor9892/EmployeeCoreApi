# Set default behavior to automatically normalize line endings
* text=auto

# Ensure C# and Visual Studio files use LF line endings in the repo, CRLF on checkout (Windows)
*.cs   text diff=csharp
*.csproj text
*.sln   text
*.config text
*.json  text
*.xml   text

# Treat binary files as binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.exe  binary
*.dll  binary

# Mark files to be merged with union strategy (optional, for lock files)
# *.lock merge=union

# End-of-line normalization for shell scripts
*.sh eol=lf
